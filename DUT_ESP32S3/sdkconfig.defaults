# DUT de referencia: ESP32-S3 (kit com CH343 no UART0, 16 MB de flash, PSRAM octal nao usada)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Tick de 1 ms: a task do ventilador (CT22) le o sensor a cada 1 ms
CONFIG_FREERTOS_HZ=1000
